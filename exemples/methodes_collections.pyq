nombres = [4, 2, 8, 2]
nombres.ajouter_tout([9, 1])
nombres.inserer(1, 7)
afficher(nombres.compter(2))
afficher(nombres.position(8))
afficher(nombres.copier())
nombres.trier()
afficher(nombres)
afficher(nombres.retirer_dernier())
nombres.inverser()
afficher(nombres)

